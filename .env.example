# ChartFlamAI API Keys
# Copy this file to .env and fill in your keys

# For local development (Vite loads VITE_ prefixed vars)
VITE_PERPLEXITY_API_KEY=your_perplexity_api_key_here
VITE_OPENAI_API_KEY=your_openai_api_key_here

# For Cloudflare Pages production (set in dashboard, not here)
# PERPLEXITY_API_KEY=...
# OPENAI_API_KEY=...
